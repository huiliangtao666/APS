{
  "name": "aps-r1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c blue,green \"vite\" \"node --experimental-strip-types server/index.mjs\"",
    "build": "tsc --noEmit && vite build && npx esbuild server/index.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs && npx esbuild server/calculation-worker.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/calculation-worker.mjs && npx esbuild server/workbook-import-worker.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/workbook-import-worker.mjs && cp server/workbook-schema.json server/workbook-simulation.json dist/",
    "test": "node --test src/lib/*.test.mjs && node --experimental-strip-types --test server/auth/auth.test.mjs server/business.test.mjs",
    "test:verification": "node --test src/lib/independent-verification.test.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "preview": "vite preview",
    "test:auth": "node --test server/auth/auth.test.mjs",
    "test:shared": "node --experimental-strip-types --test server/shared-access.test.mjs",
    "test:query-ui": "esbuild src/query-ui.test.tsx --jsx=automatic --bundle --platform=node --packages=external --format=cjs --outfile=.qa-query-ui.cjs && node --test .qa-query-ui.cjs"
  },
  "dependencies": {
    "@praetor/lite-app-runtime": "file:../../.praetor/sdk/lite-app-runtime.tgz",
    "@praetor/lite-app-server": "file:../../.praetor/sdk/lite-app-server.tgz",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
